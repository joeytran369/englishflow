---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  sortByPublished,
  pubDate,
  categoryOf,
  categorySlug,
  levelColor,
  durationSec,
  fmtDur,
  groupByCategory,
  type Episode,
} from "../lib/episodes";
const BASE = import.meta.env.BASE_URL;

const episodeFiles = import.meta.glob("../../content/*.json", {
  eager: true,
  import: "default",
});
const episodes = sortByPublished(Object.values(episodeFiles) as Episode[]);
const latest = episodes[0];
const latestCat = latest ? categoryOf(latest.plan.setting, latest.plan) : null;
const groups = groupByCategory(episodes);
const BUILD = Date.now().toString(36);
const PREVIEW_PER_CAT = 4; // cards shown per category section before "See all"
---

<BaseLayout
  title="EnglishFlow — Daily English for Cloud Tech Lovers"
  description="AI-generated daily dialogues for everyone who loves Cloud tech. Listen, read, learn the jargon."
  ogImage={latest?.poster?.file ? `posters/${latest.poster.file}` : undefined}
>
  <main class="px-6 lg:px-12 py-10 lg:py-14 max-w-3xl mx-auto">

    <section class="pb-8">
      <h1 class="text-[36px] sm:text-[44px] font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
        English<span class="italic-serif text-emerald-600 dark:text-emerald-400">Flow</span>
      </h1>
      <p class="text-[15px] text-zinc-600 dark:text-zinc-400 leading-[1.7] mt-3 max-w-[520px]">
        Daily English for everyone who loves Cloud tech — short dialogues from real work moments.
      </p>
    </section>

    {latest && (
      <section class="pb-10">
        <div class="text-[11px] font-mono uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-400 mb-3">
          Latest · {pubDate(latest)}
        </div>
        <a
          href={`${BASE}${latest.id}/?v=${BUILD}`}
          class="block rounded-2xl overflow-hidden border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 dark:hover:border-emerald-400 transition-colors group"
        >
          <div class="relative aspect-[5/2] overflow-hidden">
            {latest.poster?.file ? (
              <img src={`${BASE}posters/${latest.poster.file}`} alt={latest.dialogue.title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            ) : (
              <div class={`absolute inset-0 bg-gradient-to-br ${latestCat!.gradient}`}></div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
            <div class="relative h-full flex flex-col justify-between p-5">
              <div class="flex justify-between items-start">
                <span class="px-2.5 py-1 rounded-full bg-zinc-900/85 backdrop-blur-sm text-white text-[11px] font-semibold tracking-wide ring-1 ring-white/15">{latestCat!.name}</span>
                <span class={`px-2 py-0.5 rounded-md border text-[11px] font-mono shadow-sm ${levelColor[latest.plan.level] ?? levelColor.B2}`}>{latest.plan.level}</span>
              </div>
              <div class="text-poster">
                <h2 class="text-white text-[26px] sm:text-[30px] font-semibold tracking-tight leading-tight">
                  {latest.dialogue.title}
                </h2>
                <p class="text-white/95 text-[13px] mt-1 italic-serif line-clamp-2">
                  {latest.plan.setting}
                </p>
              </div>
            </div>
          </div>
          <div class="px-5 py-3 flex items-center justify-between text-[12px] text-zinc-500 dark:text-zinc-400">
            <div class="flex items-center gap-3 font-mono tabular-nums">
              <span>{fmtDur(durationSec(latest))}</span>
              <span class="text-zinc-300 dark:text-zinc-700">·</span>
              <span>{latest.vocab.length} terms</span>
            </div>
            <span class="font-medium text-emerald-600 dark:text-emerald-400 group-hover:translate-x-0.5 transition-transform">Open →</span>
          </div>
        </a>
      </section>
    )}

    {groups.map((g) => {
      const preview = g.episodes.slice(0, PREVIEW_PER_CAT);
      const hasMore = g.episodes.length > PREVIEW_PER_CAT;
      return (
        <section class="py-8 border-t border-zinc-200 dark:border-zinc-800">
          <div class="flex items-end justify-between mb-4">
            <a href={`${BASE}category/${g.slug}/?v=${BUILD}`} class="flex items-center gap-2.5 group">
              <span class={`inline-block w-1.5 h-1.5 rounded-full ${g.style.dot}`}></span>
              <h3 class="text-[15px] font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                {g.name}
              </h3>
              <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500 tabular-nums">({g.episodes.length})</span>
            </a>
            <a href={`${BASE}category/${g.slug}/?v=${BUILD}`} class="text-[12px] font-medium text-emerald-600 dark:text-emerald-400 hover:translate-x-0.5 inline-block transition-transform">
              {hasMore ? `See all ${g.episodes.length} →` : "View →"}
            </a>
          </div>
          <div class="grid sm:grid-cols-2 gap-3">
            {preview.map((e) => {
              const c = categoryOf(e.plan.setting, e.plan);
              return (
                <a
                  href={`${BASE}${e.id}/?v=${BUILD}`}
                  class="block rounded-xl overflow-hidden border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 dark:hover:border-emerald-400 hover:shadow-sm transition-all group"
                >
                  <div class="relative aspect-[5/2] overflow-hidden">
                    {e.poster?.file ? (
                      <img src={`${BASE}posters/${e.poster.file}`} alt={e.dialogue.title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
                    ) : (
                      <div class={`absolute inset-0 bg-gradient-to-br ${c.gradient}`}></div>
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/15 to-transparent"></div>
                    <div class="relative h-full flex flex-col justify-between p-3">
                      <div class="flex items-start justify-between">
                        <span class="px-2 py-0.5 rounded-full bg-zinc-900/85 backdrop-blur-sm text-white text-[10px] font-semibold ring-1 ring-white/15">{c.name}</span>
                        <span class={`px-1.5 py-0 rounded-md text-[10px] font-mono shadow-sm ${levelColor[e.plan.level] ?? levelColor.B2}`}>{e.plan.level}</span>
                      </div>
                      <h4 class="text-poster text-white text-[15px] font-semibold leading-tight line-clamp-2">
                        {e.dialogue.title}
                      </h4>
                    </div>
                  </div>
                  <div class="px-3 py-2 flex items-center justify-between text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
                    <span class="tabular-nums">{pubDate(e)}</span>
                    <span class="group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">{fmtDur(durationSec(e))} · {e.vocab.length} terms →</span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      );
    })}

  </main>
</BaseLayout>
