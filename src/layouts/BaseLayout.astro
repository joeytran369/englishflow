---
import "../styles/global.css";
import {
  sortByPublished,
  categoryOf,
  levelColor,
  durationSec,
  fmtDur,
  type Episode,
} from "../lib/episodes";

interface Props {
  title: string;
  description?: string;
  activeId?: string;
  /** Path (relative to BASE) for the OG/Twitter share image. Falls back to latest episode poster. */
  ogImage?: string;
  /** "website" (default) or "article" for episode pages */
  ogType?: "website" | "article";
}
const {
  title,
  description = "Daily English for everyone who loves Cloud tech.",
  activeId,
  ogImage,
  ogType = "website",
} = Astro.props;
const BASE = import.meta.env.BASE_URL;

const episodeFiles = import.meta.glob("../../content/*.json", {
  eager: true,
  import: "default",
});
const episodes = sortByPublished(Object.values(episodeFiles) as Episode[]);
// Cache-bust internal links: rebuild every deploy => new query string => browser refetches HTML
const BUILD = Date.now().toString(36);

// Build absolute URLs for OG meta (LinkedIn/Facebook crawlers don't follow relative paths).
const SITE = (Astro.site?.toString() || "https://joeytrancloud.github.io/").replace(/\/$/, "");
const fallbackPoster = episodes.find((e: any) => e.poster?.file)?.poster?.file;
const ogImagePath = ogImage || (fallbackPoster ? `posters/${fallbackPoster}` : "favicon.svg");
const ogImageUrl = `${SITE}${BASE}${ogImagePath}`;
const pageUrl = `${SITE}${Astro.url.pathname}`;
---
<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={pageUrl} />
    <title>{title}</title>

    <!-- Open Graph (LinkedIn / Facebook / Slack / Discord) -->
    <meta property="og:site_name" content="EnglishFlow" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="512" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="vi_VN" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Lora:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const t = localStorage.getItem("theme") ?? "light";
      if (t === "dark") document.documentElement.classList.add("dark");
      // Bust bfcache so browser-back/navigation never restores stale page
      window.addEventListener("pageshow", (e) => {
        if (e.persisted) window.location.reload();
      });
    </script>

    <!-- Cloudflare Web Analytics — privacy-friendly, no cookies, free unlimited -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "f4d2252cac1b4c62ad9323d42246563d"}'></script>
  </head>
  <body class="bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100">

    <!-- Mobile top bar (sidebar collapsed by default on small screens) -->
    <div class="lg:hidden sticky top-0 z-30 flex items-center justify-between h-14 px-4 border-b border-zinc-200 dark:border-zinc-800 bg-white/90 dark:bg-zinc-950/90 backdrop-blur">
      <a href={`${BASE}?v=${BUILD}`} class="font-mono font-bold text-zinc-900 dark:text-zinc-200">
        English<span class="italic-serif text-emerald-600 dark:text-emerald-400">Flow</span>
      </a>
      <button id="sb-open" aria-label="Open menu" class="p-2 -mr-2 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 cursor-pointer">
        <svg class="w-5 h-5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 4h12M2 8h12M2 12h12"/></svg>
      </button>
    </div>

    <!-- Sidebar backdrop (mobile only) -->
    <div id="sb-backdrop" class="lg:hidden fixed inset-0 z-40 bg-black/40 backdrop-blur-sm hidden"></div>

    <div class="lg:flex">

      <!-- SIDEBAR -->
      <aside
        id="sidebar"
        class="fixed lg:sticky top-0 left-0 z-50 h-screen w-72 flex-none border-r border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 flex flex-col -translate-x-full lg:translate-x-0 transition-transform duration-200"
      >
        <!-- Brand + always-visible utility actions (theme, contact) -->
        <div class="px-5 pt-6 pb-4 border-b border-zinc-200 dark:border-zinc-800">
          <div class="flex items-start justify-between gap-2">
            <a href={`${BASE}?v=${BUILD}`} class="text-[20px] font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              English<span class="italic-serif text-emerald-600 dark:text-emerald-400">Flow</span>
            </a>
            <div class="flex items-center gap-0.5 shrink-0 -mr-1">
              <button id="theme-toggle" aria-label="Toggle theme" title="Toggle theme" class="p-1.5 rounded-md text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800/70 cursor-pointer transition-colors">
                <svg id="theme-icon-sun" class="w-4 h-4 hidden dark:block" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="3"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.5 3.5l1.4 1.4M11.1 11.1l1.4 1.4M3.5 12.5l1.4-1.4M11.1 4.9l1.4-1.4"/></svg>
                <svg id="theme-icon-moon" class="w-4 h-4 dark:hidden" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 9.5A6 6 0 016.5 3a4.5 4.5 0 105.5 6.5z"/></svg>
              </button>
              <a href="https://www.linkedin.com/in/joeytrancloud" target="_blank" rel="noopener" aria-label="LinkedIn" title="Connect on LinkedIn" class="p-1.5 rounded-md text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/70 transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              </a>
              <button id="sb-close" aria-label="Close menu" class="lg:hidden p-1.5 rounded-md text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800/70 cursor-pointer">
                <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4l8 8M12 4l-8 8"/></svg>
              </button>
            </div>
          </div>
          <p class="text-[12px] text-zinc-500 dark:text-zinc-400 mt-1.5 leading-snug">
            Daily English for Cloud tech lovers.
          </p>
        </div>

        <!-- Episode list -->
        <nav class="flex-1 overflow-y-auto px-3 pt-3 pb-4 space-y-0.5">
          {episodes.length === 0 ? (
            <p class="px-2 py-3 text-[12px] text-zinc-500 dark:text-zinc-400 italic-serif">No episodes yet.</p>
          ) : (
            episodes.map((e, i) => {
              const c = categoryOf(e.plan.setting, e.plan);
              const isActive = e.id === activeId;
              return (
                <a
                  href={`${BASE}${e.id}/?v=${BUILD}`}
                  class={`flex items-center gap-3 px-2.5 py-2 rounded-lg transition-colors ${
                    isActive
                      ? "bg-emerald-50 dark:bg-emerald-950/40"
                      : "hover:bg-zinc-50 dark:hover:bg-zinc-900/60"
                  }`}
                >
                  <span class={`shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-[12px] font-semibold ${
                    isActive
                      ? "bg-emerald-500 text-white"
                      : "bg-zinc-100 dark:bg-zinc-800/80 text-zinc-500 dark:text-zinc-400"
                  }`}>
                    {isActive ? (
                      <svg class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor"><path d="M3 2v12l11-6L3 2z"/></svg>
                    ) : (
                      <span class="tabular-nums">{i + 1}</span>
                    )}
                  </span>
                  <div class="flex-1 min-w-0">
                    <div class={`text-[14px] leading-tight truncate ${isActive ? "text-emerald-700 dark:text-emerald-300 font-medium" : "text-zinc-800 dark:text-zinc-200"}`}>
                      {e.dialogue.title.split(/[:—–]/)[0].trim()}
                    </div>
                    <div class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5 truncate">
                      {c.name}
                    </div>
                  </div>
                </a>
              );
            })
          )}
        </nav>

      </aside>

      <!-- MAIN -->
      <div class="flex-1 min-w-0 flex flex-col">
        <div class="flex-1">
          <slot />
        </div>
        <!-- Global footer (About + Contact + AI disclosure) — shown on every page -->
        <footer class="border-t border-zinc-200 dark:border-zinc-800 px-6 lg:px-12 py-8 text-[12px] text-zinc-500 dark:text-zinc-400 max-w-3xl mx-auto w-full space-y-3">
          <div class="space-y-1.5">
            <p class="text-zinc-600 dark:text-zinc-300 leading-relaxed">
              <strong class="font-medium text-zinc-800 dark:text-zinc-100">EnglishFlow</strong> — daily English dialogues for anyone who loves Cloud tech.
            </p>
            <p class="leading-relaxed">
              Episodes are <span class="font-medium">AI-generated</span> (scripted, voiced, posters) for English-learning practice. Built for fun by a fellow Cloud engineer.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <a href="https://www.linkedin.com/in/joeytrancloud" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              Connect on LinkedIn
            </a>
          </div>
          <div class="pt-3 border-t border-zinc-200/50 dark:border-zinc-800/50 text-center text-[11px] text-zinc-400 dark:text-zinc-500">
            © {new Date().getFullYear()} EnglishFlow · Made with <span class="text-rose-500">❤</span> by Joey Tran
          </div>
        </footer>
      </div>
    </div>

    <script is:inline>
      // Theme toggle
      const btn = document.getElementById("theme-toggle");
      btn?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
      // Mobile sidebar drawer
      const sb = document.getElementById("sidebar");
      const bd = document.getElementById("sb-backdrop");
      function openSb() { sb?.classList.remove("-translate-x-full"); bd?.classList.remove("hidden"); }
      function closeSb() { sb?.classList.add("-translate-x-full"); bd?.classList.add("hidden"); }
      document.getElementById("sb-open")?.addEventListener("click", openSb);
      document.getElementById("sb-close")?.addEventListener("click", closeSb);
      bd?.addEventListener("click", closeSb);
    </script>
  </body>
</html>
